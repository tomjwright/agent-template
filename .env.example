# Copy to .env and fill in. Never commit .env.

# Chat model as "provider:model". Default: anthropic:claude-haiku-4-5
LLM_MODEL=anthropic:claude-haiku-4-5
ANTHROPIC_API_KEY=

# Where run history is stored (SQLite)
RUN_DB=data/runs.db

# Optional: OTLP HTTP endpoint for traces (Jaeger, Langfuse, ...)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LOG_LEVEL=INFO
