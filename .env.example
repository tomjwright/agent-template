# Copy to .env and fill in. Never commit .env.

# Chat model as "provider:model". Default: anthropic:claude-haiku-4-5
LLM_MODEL=anthropic:claude-haiku-4-5
ANTHROPIC_API_KEY=

# For Gemini instead: LLM_MODEL=google_genai:gemini-3.5-flash
# GOOGLE_API_KEY=

# Where run history is stored when DATABASE_URL is unset (SQLite)
RUN_DB=data/runs.db

# Optional: Postgres for durable run checkpoints (any replica can resume any run)
# and shared run history. Unset = checkpoints in memory, history in RUN_DB.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Optional: OTLP HTTP endpoint for traces (Jaeger, Langfuse, ...)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LOG_LEVEL=INFO
